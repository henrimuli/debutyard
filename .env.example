# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: transaction pooler (port 6543), used by the app.
# DIRECT_DATABASE_URL: direct or session connection (port 5432), used for migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# The real production database. ONLY for `pnpm db:migrate --master`. NEVER use these for testing of any kind.
DATABASE_URL_MASTER=
DIRECT_DATABASE_URL_MASTER=

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional social sign-in. Callback URLs: {SITE_URL}/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend). Without a key, emails are printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM="DebutYard <hello@debutyard.com>"
ADMIN_EMAIL=

# Paystack → Settings → API Keys & Webhooks. Use sk_test_... until you go live.
# Webhook URL: {SITE_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# PayPal → developer.paypal.com → Apps & Credentials. Webhook URL: {SITE_URL}/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Cloudflare R2 → R2 → Manage API tokens (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=debutyard
R2_PUBLIC_URL=https://cdn.debutyard.com

# Domain Rating snapshots and the free DR checker (optional; unset hides them).
# Authority Score. DR_PROVIDER: dataforseo (default when unset) | ahrefs | openpagerank (free, rough 0-10 shown as 0-100).
# DR_API_KEY: DataForSEO API "login:password", an Ahrefs API v3 key, or an Open PageRank key.
DR_PROVIDER=
DR_API_KEY=
# Public checker: provider lookups per rolling day across all visitors (default 300).
DR_DAILY_PROVIDER_CAP=
# Cloudflare Turnstile, invisible widget on the checker. Leave empty in development to skip the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Per-order submission inboxes ({key}@INBOUND_EMAIL_DOMAIN), received by Resend and delivered to
# /api/webhooks/resend (needs RESEND_WEBHOOK_SECRET below and the email.received event).
INBOUND_EMAIL_DOMAIN=
# Encrypts directory account passwords at rest. Generate with: openssl rand -base64 32
CREDENTIALS_KEY=

# Screenshot worker (workers/screenshot) for listing evidence (optional).
WORKER_URL=
WORKER_SECRET=

# Firecrawl (firecrawl.dev), the fallback for pages that block or fail our direct fetch (optional).
FIRECRAWL_API_KEY=

# Weekly Google index check of live listings (optional). SERP_PROVIDER: serpapi | dataforseo.
SERP_PROVIDER=
SERP_API_KEY=

# Gemini API (aistudio.google.com/apikey, on a project with billing on). The blog writer agent:
# gemini-3.1-flash-lite writes, Nano Banana 2.1 draws images. Without it the agent is off.
GEMINI_API_KEY=

# Google Keyword Planner for the blog writer (optional). Same Google Cloud OAuth client and Ads account as Hivra.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# 10 digits, no dashes. Add the manager (MCC) id too if the account sits under one.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Resend webhook signing secret (whsec_…) for newsletter open/click stats (optional).
RESEND_WEBHOOK_SECRET=

# Vercel Cron bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=
